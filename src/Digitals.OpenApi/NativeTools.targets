<Project>

	<!--
		vacuum (lint, reports) and oasdiff (diff, breaking changes) ship inside the tool as native binaries.
		Each RID-specific package downloads its own pair at build time, checks the SHA-256 from the release
		page, and copies the binary and its licence to native/. A plain build uses the machine's RID.
		To upgrade, change a version and every hash for it, then run `just test`.
	-->
	<PropertyGroup>
		<VacuumVersion>0.35.2</VacuumVersion>
		<OasdiffVersion>1.35.0</OasdiffVersion>
		<_NativeRid>$(RuntimeIdentifier)</_NativeRid>
		<_NativeRid Condition="'$(_NativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_NativeRid>
		<_NativeExe Condition="$(_NativeRid.StartsWith('win'))">.exe</_NativeExe>
		<_NativeCache>$(BaseIntermediateOutputPath)native/</_NativeCache>
	</PropertyGroup>

	<ItemGroup>
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="osx-arm64" Asset="darwin_arm64" Archive="vacuum_$(VacuumVersion)_darwin_arm64.tar.gz" Sha256="078821285bb3b78559fcb1de93a6ecb23defac913a45cc4dd1bc037a4b7034a9" />
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="osx-x64" Asset="darwin_x86_64" Archive="vacuum_$(VacuumVersion)_darwin_x86_64.tar.gz" Sha256="f4bb2ec51ed599c92192c08cf09b151c5918d5b507253b72582ab65bbc47370b" />
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="linux-arm64" Asset="linux_arm64" Archive="vacuum_$(VacuumVersion)_linux_arm64.tar.gz" Sha256="a02c237b5915b33f7dfd12b7ae920b154b855da22c21876182477a56c845fede" />
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="linux-x64" Asset="linux_x86_64" Archive="vacuum_$(VacuumVersion)_linux_x86_64.tar.gz" Sha256="1acc9f25cfa05dea7c76fb0b20dacd28e4f4c1bf6fe8cc2ee6b8091465dd1e95" />
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="win-arm64" Asset="windows_arm64" Archive="vacuum_$(VacuumVersion)_windows_arm64.tar.gz" Sha256="0cdba3ff3e207419623adc314bc046f51604cedf7f1475601f8971f69e25225f" />
		<_NativeAsset Include="vacuum" Version="$(VacuumVersion)" Repository="daveshanley/vacuum" Rid="win-x64" Asset="windows_x86_64" Archive="vacuum_$(VacuumVersion)_windows_x86_64.tar.gz" Sha256="db2303b151252d04ad1160d5b617d2dfd6aa9aa108fa5cac68b5a2b1aa65c948" />

		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="osx-arm64" Asset="darwin_all" Archive="oasdiff_$(OasdiffVersion)_darwin_all.tar.gz" Sha256="964ad2c0331768c4515fc49779827094bc89a65b1d309dac28886d1c3faf305c" />
		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="osx-x64" Asset="darwin_all" Archive="oasdiff_$(OasdiffVersion)_darwin_all.tar.gz" Sha256="964ad2c0331768c4515fc49779827094bc89a65b1d309dac28886d1c3faf305c" />
		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="linux-arm64" Asset="linux_arm64" Archive="oasdiff_$(OasdiffVersion)_linux_arm64.tar.gz" Sha256="1f8b5aa033cd0240ae6c53460268bcd6e578526666a4487a781ece8cef39fbdd" />
		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="linux-x64" Asset="linux_amd64" Archive="oasdiff_$(OasdiffVersion)_linux_amd64.tar.gz" Sha256="a8023002fcb2eaa7f5758148a9303cb63d33b939886df312268bc0fc7b939140" />
		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="win-arm64" Asset="windows_arm64" Archive="oasdiff_$(OasdiffVersion)_windows_arm64.tar.gz" Sha256="da981a1d29092d43e692e65f90c5ce90232849e2aa9a7c1e417bd85108e58d98" />
		<_NativeAsset Include="oasdiff" Version="$(OasdiffVersion)" Repository="oasdiff/oasdiff" Rid="win-x64" Asset="windows_amd64" Archive="oasdiff_$(OasdiffVersion)_windows_amd64.tar.gz" Sha256="5cdea2b64bd083d16dff19dba3aae011a0b7388ab33df81051cfc76800bf73e0" />
	</ItemGroup>

	<Target Name="_DigitalsSelectNativeTools">
		<ItemGroup>
			<_NativeTool Include="@(_NativeAsset)" Condition="'%(Rid)' == '$(_NativeRid)'" />
		</ItemGroup>
		<Error Condition="'@(_NativeTool->Count())' != '2'" Text="No vacuum and oasdiff builds for RID '$(_NativeRid)'. Supported: @(_NativeAsset->'%(Rid)'->Distinct())." />
	</Target>

	<!-- Runs once per tool. -->
	<Target Name="_DigitalsFetchNativeTool" DependsOnTargets="_DigitalsSelectNativeTools" Outputs="%(_NativeTool.Identity)">
		<!-- Under its RID: osx-arm64 and osx-x64 share oasdiff's darwin_all archive and pack in parallel. -->
		<PropertyGroup>
			<_ArchiveFolder>$(_NativeCache)%(_NativeTool.Rid)/</_ArchiveFolder>
			<_Archive>$(_ArchiveFolder)%(_NativeTool.Archive)</_Archive>
			<_Expected>%(_NativeTool.Sha256)</_Expected>
		</PropertyGroup>

		<DownloadFile Condition="!Exists('$(_Archive)')"
			SourceUrl="https://github.com/%(_NativeTool.Repository)/releases/download/v%(_NativeTool.Version)/%(_NativeTool.Archive)"
			DestinationFolder="$(_ArchiveFolder)" />

		<GetFileHash Files="$(_Archive)" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_Actual" />
		</GetFileHash>
		<Delete Condition="'$(_Actual.ToLowerInvariant())' != '$(_Expected)'" Files="$(_Archive)" />
		<Error Condition="'$(_Actual.ToLowerInvariant())' != '$(_Expected)'" Text="%(_NativeTool.Archive) has SHA-256 $(_Actual), expected $(_Expected). Deleted it; the next build downloads it again." />

		<MakeDir Directories="$(_NativeCache)%(_NativeTool.Identity)-%(_NativeTool.Version)-%(_NativeTool.Rid)/" />
		<Exec Condition="!Exists('$(_NativeCache)%(_NativeTool.Identity)-%(_NativeTool.Version)-%(_NativeTool.Rid)/%(_NativeTool.Identity)$(_NativeExe)')"
			Command="tar -xzmf &quot;$(_Archive)&quot; -C &quot;$(_NativeCache)%(_NativeTool.Identity)-%(_NativeTool.Version)-%(_NativeTool.Rid)/.&quot;" />
	</Target>

	<Target Name="DigitalsAddNativeTools" BeforeTargets="AssignTargetPaths" DependsOnTargets="_DigitalsFetchNativeTool">
		<ItemGroup>
			<None Include="$(_NativeCache)%(_NativeTool.Identity)-%(_NativeTool.Version)-%(_NativeTool.Rid)/%(_NativeTool.Identity)$(_NativeExe)"
				Link="native/%(_NativeTool.Identity)$(_NativeExe)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
			<None Include="$(_NativeCache)%(_NativeTool.Identity)-%(_NativeTool.Version)-%(_NativeTool.Rid)/LICENSE"
				Link="native/%(_NativeTool.Identity).LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

</Project>
