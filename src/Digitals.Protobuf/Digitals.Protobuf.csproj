<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RollForward>Major</RollForward>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dt-protobuf</ToolCommandName>
		<!-- One package per RID, each carrying that platform's buf and protoc-gen-doc. -->
		<RuntimeIdentifiers>osx-arm64;osx-x64;linux-arm64;linux-x64;win-arm64;win-x64</RuntimeIdentifiers>

		<PackageId>Digitals.Protobuf</PackageId>
		<!-- Released by tagging protobuf/v1.2.0, which packs 1.2.0. -->
		<MinVerTagPrefix>protobuf/v</MinVerTagPrefix>
		<Description>Lints .proto files for gRPC APIs against the Digitals rules, checks their formatting, fails on breaking changes, and writes them as an offline documentation page. Bundles buf and protoc-gen-doc, so it needs nothing else installed.</Description>
		<PackageTags>protobuf;proto;grpc;lint;buf;breaking-changes;api;contract;dotnet-tool</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="buf.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="buf-baseline.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Compile Include="..\ViewerPage.cs" Link="ViewerPage.cs" />
		<None Include="viewer/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- To upgrade buf, change the version and every hash (from the release's sha256.txt), then run `just test`. -->
	<PropertyGroup>
		<BufVersion>1.74.0</BufVersion>
		<_BufRelease>https://github.com/bufbuild/buf/releases/download/v$(BufVersion)</_BufRelease>
	</PropertyGroup>

	<ItemGroup>
		<_NativeDownload Include="buf" Executable="true" Rid="osx-arm64" Url="$(_BufRelease)/buf-Darwin-arm64" Sha256="602d73e39a8835efd29a02ba6db6060ae86e4a0df19b8ac4403032b5deae3569" />
		<_NativeDownload Include="buf" Executable="true" Rid="osx-x64" Url="$(_BufRelease)/buf-Darwin-x86_64" Sha256="a385ecb788f4255c855d0e77643a60ed0de23f9eb978bd54d695c820aa29e172" />
		<_NativeDownload Include="buf" Executable="true" Rid="linux-arm64" Url="$(_BufRelease)/buf-Linux-aarch64" Sha256="d42b471501a85dbadb40062960492dd81ce5ca4e413f4133d514d3ae3c0af4df" />
		<_NativeDownload Include="buf" Executable="true" Rid="linux-x64" Url="$(_BufRelease)/buf-Linux-x86_64" Sha256="92326d957d613712669fb55f9e4340946a8142a92120e09008459118778273d2" />
		<_NativeDownload Include="buf" Executable="true" Rid="win-arm64" Url="$(_BufRelease)/buf-Windows-arm64.exe" Sha256="681d1d56d42d7e5d74cbcd940cc0e8d656aed66d926a1e0c9f6ef9bd514d8fff" />
		<_NativeDownload Include="buf" Executable="true" Rid="win-x64" Url="$(_BufRelease)/buf-Windows-x86_64.exe" Sha256="0677ba830deceadd619455b058631cc00ffbe305858e03d6a90b17b12cb16d38" />
		<_NativeDownload Include="buf.LICENSE" Rid="any" Url="https://raw.githubusercontent.com/bufbuild/buf/v$(BufVersion)/LICENSE" Sha256="995b27237c0d8ef8c970d36da9e81f1472790ae18f3d7d5a966781b53d78f242" />
	</ItemGroup>

	<!-- protoc-gen-doc reads the files buf compiles for `docs`. To upgrade, change the version and every hash (from the release's checksums.txt). -->
	<PropertyGroup>
		<ProtocGenDocVersion>1.5.1</ProtocGenDocVersion>
		<_ProtocGenDocRelease>https://github.com/pseudomuto/protoc-gen-doc/releases/download/v$(ProtocGenDocVersion)/protoc-gen-doc_$(ProtocGenDocVersion)</_ProtocGenDocRelease>
	</PropertyGroup>

	<ItemGroup>
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="osx-arm64" Url="$(_ProtocGenDocRelease)_darwin_arm64.tar.gz" Extract="protoc-gen-doc" Sha256="6e8c737d9a67a6a873a3f1d37ed8bb2a0a9996f6dcf6701aa1048c7bd798aaf9" />
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="osx-x64" Url="$(_ProtocGenDocRelease)_darwin_amd64.tar.gz" Extract="protoc-gen-doc" Sha256="f429e5a5ddd886bfb68265f2f92c1c6a509780b7adcaf7a8b3be943f28e144ba" />
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="linux-arm64" Url="$(_ProtocGenDocRelease)_linux_arm64.tar.gz" Extract="protoc-gen-doc" Sha256="172e6a191daced8eb31ebcd90d4523a1affa6d07900a89b548421823dda796fe" />
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="linux-x64" Url="$(_ProtocGenDocRelease)_linux_amd64.tar.gz" Extract="protoc-gen-doc" Sha256="47cd72b07e6dab3408d686a65d37d3a6ab616da7d8b564b2bd2a2963a72b72fd" />
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="win-arm64" Url="$(_ProtocGenDocRelease)_windows_arm64.tar.gz" Extract="protoc-gen-doc.exe" Sha256="bf8bc651c17e64bfec663192e660655c2bcc415f6dff9e88201d8b07fb23d493" />
		<_NativeDownload Include="protoc-gen-doc" Executable="true" Rid="win-x64" Url="$(_ProtocGenDocRelease)_windows_amd64.tar.gz" Extract="protoc-gen-doc.exe" Sha256="8acf0bf64eda29183b4c6745c3c6a12562fd9a8ab08d61788cf56e6659c66b3b" />
		<_NativeDownload Include="protoc-gen-doc.LICENSE" Rid="any" Url="https://raw.githubusercontent.com/pseudomuto/protoc-gen-doc/v$(ProtocGenDocVersion)/LICENSE.md" Sha256="73fa38ee85810bdfd97393bf9b2c1a3acf68795e62905cc65d82d02745ae822d" />
	</ItemGroup>

	<Import Project="..\NativeBinaries.targets" />

</Project>
