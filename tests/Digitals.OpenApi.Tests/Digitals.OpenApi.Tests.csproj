<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Digitals.Testing" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\VersionCheckTests.cs" Link="VersionCheckTests.cs" />
	</ItemGroup>

	<!-- Brings the tool, its ruleset and this machine's vacuum and oasdiff into the test output. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\Digitals.OpenApi\Digitals.OpenApi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\examples\openapi.yaml" Link="examples/openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\rules\openapi.md" Link="docs/rules/openapi.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
