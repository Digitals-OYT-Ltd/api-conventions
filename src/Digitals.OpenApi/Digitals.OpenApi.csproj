<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RollForward>Major</RollForward>
		<!-- Native AOT: each RID packs as one native executable, packed on that OS (scripts/pack.ps1 -Rid). It turns on
		     the trim and AOT analyzers for every build too, so reflection that AOT can't compile fails it. The
		     native debug symbols (.dSYM, .dbg, .pdb) stay out of the package. -->
		<PublishAot>true</PublishAot>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
		<!-- No ICU: the output never depends on the machine's culture, and the Linux binary runs without
		     libicu, as in a slim container. -->
		<InvariantGlobalization>true</InvariantGlobalization>

		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dt-openapi</ToolCommandName>
		<!-- One package per RID, each carrying that platform's vacuum and oasdiff (NativeTools.targets). -->
		<RuntimeIdentifiers>osx-arm64;osx-x64;linux-arm64;linux-x64;win-arm64;win-x64</RuntimeIdentifiers>

		<PackageId>Digitals.OpenApi</PackageId>
		<!-- Released by tagging openapi/v1.2.0, which packs 1.2.0. -->
		<MinVerTagPrefix>openapi/v</MinVerTagPrefix>
		<Description>Lints any OpenAPI 3.0 or 3.1 document against the Digitals API rules and diffs a design against its implementation. Bundles vacuum and oasdiff, so it needs nothing else installed.</Description>
		<PackageTags>openapi;lint;spectral;vacuum;oasdiff;api;contract;dotnet-tool</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" PrivateAssets="all" />
		<!-- Reads a contract for `cases`. It brings Microsoft.OpenApi and SharpYaml. -->
		<PackageReference Include="Microsoft.OpenApi.YamlReader" />
	</ItemGroup>

	<ItemGroup>
		<None Include="digitals.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="digitals-baseline.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="functions/*.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Compile Include="..\ViewerPage.cs" Link="ViewerPage.cs" />
		<Compile Include="..\ContractYaml.cs" Link="ContractYaml.cs" />
		<Compile Include="..\SchemaRules.cs" Link="SchemaRules.cs" />
		<Compile Include="..\CaseList.cs" Link="CaseList.cs" />
		<Compile Include="..\Sentences.cs" Link="Sentences.cs" />
		<Compile Include="..\VersionCheck.cs" Link="VersionCheck.cs" />
		<None Include="viewer/*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="breaking-levels.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Swagger UI for `dt-openapi docs`. To upgrade, change the version and every hash, then run `just test`. -->
	<PropertyGroup>
		<SwaggerUiVersion>5.34.1</SwaggerUiVersion>
		<_SwaggerUi>https://cdn.jsdelivr.net/npm/swagger-ui-dist@$(SwaggerUiVersion)</_SwaggerUi>
	</PropertyGroup>

	<ItemGroup>
		<_WebAsset Include="swagger-ui-bundle.js" Url="$(_SwaggerUi)/swagger-ui-bundle.js" Sha256="36eeb4d5640b9c036b1d0f854499af1cceebbdb260b790a03a18be5e8488fbf5" />
		<_WebAsset Include="swagger-ui.css" Url="$(_SwaggerUi)/swagger-ui.css" Sha256="c3cfe8248c4b0b89673600fb829924eafbac6de4bc4b2b06f5f5243483074d0a" />
		<_WebAsset Include="swagger-ui.LICENSE" Url="$(_SwaggerUi)/LICENSE" Sha256="cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30" />
	</ItemGroup>

	<Import Project="NativeTools.targets" />
	<Import Project="..\WebAssets.targets" />

</Project>
