root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{props,csproj}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{cs,vb,cshtml}]
indent_style = space
indent_size = 4
tab_width = 4
# editor ruler only — the build gate is RCS0056 in the package, same 120
max_line_length = 120

[tests/Digitals.OpenApi.Tests/RulesetTests.cs]
# RCS0056: each fixture is a line of flow-style YAML that vacuum reads as written, so wrapping it would
# change the contract under test.
dotnet_diagnostic.RCS0056.severity = none

[tests/Digitals.{OpenApi,AsyncApi,Protobuf}.Tests/CasesTests.cs]
# RCS0056: the contract is flow-style YAML like RulesetTests.cs, or a .proto with its rules on one line, and each
# expected detail is one line of the tool's output, which reads best whole.
dotnet_diagnostic.RCS0056.severity = none

[src/VersionCheck.cs]
# DT00003: a tool run makes one request and exits, with no DI container to hold an IHttpClientFactory, so a
# client per run exhausts nothing.
dotnet_diagnostic.DT00003.severity = none
